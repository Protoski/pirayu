# Copiar a .env.local (desarrollo) o cargar en Vercel > Settings > Environment Variables.
# NUNCA commitear valores reales.

# Origen público del sitio (protección CSRF por cabecera Origin). Ej.: https://www.pirayu.gov.py
APP_ORIGIN=

# Secreto HMAC para tokens CSRF. Generar: openssl rand -base64 32
CSRF_SECRET=

# Clave AES-256-GCM (32 bytes en base64) para cifrar campos sensibles. Generar: openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# Rate limiting distribuido (opcional; sin estas variables se usa un limitador en memoria por instancia).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Identidad Electrónica MITIC / OIDC (pendiente de convenio; sin valores el login responde 503).
MITIC_OIDC_ISSUER=
MITIC_OIDC_CLIENT_ID=
MITIC_OIDC_REDIRECT_URI=

# Pasarela de pago (pendiente de contrato; sin valor los pagos responden 503).
PAYMENT_PROVIDER=

# Mantener true durante la presentación. Desactivar solo después de las integraciones municipales.
NEXT_PUBLIC_MODO_DEMOSTRACION=true
